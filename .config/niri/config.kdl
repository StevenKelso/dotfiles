input {
    keyboard {
        xkb {
        }
        numlock
        repeat-delay 250
        repeat-rate 40
    }

    touchpad {
        tap
        drag-lock
    }

    mouse {
        //
    }

    trackpoint {
        //
    }

    warp-mouse-to-focus
    focus-follows-mouse max-scroll-amount="0%"
}


output "DP-3" {
    // `niri msg outputs` to see monitors
    mode "3440x1440"
    scale 1
    transform "normal"
}

output "eDP-1" {
    scale 1
    transform "normal"
}


layout {
    gaps 16
    always-center-single-column
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    border {
        on
        width 2
        active-gradient from="#d8a657" to="#181616" angle=180 relative-to="workspace-view"
        inactive-color "#181616"
        urgent-color "#cc241d"
    }

    focus-ring {
        off
    }

    shadow {
        on
        softness 5
        spread 4
        offset x=5 y=5
        color "#111111"
    }

    struts {
    }
}


gestures {
    hot-corners {
        off
    }
}


hotkey-overlay {
    skip-at-startup
}


window-rule {
    open-maximized false
    open-maximized-to-edges false
}


spawn-at-startup "awww-daemon"
spawn-at-startup "awww" "img" "~/.config/images/course_of_empire_destruction.jpg"
spawn-at-startup "wlsunset" "-t" "3400" "-T" "3800" "-s" "20:00" "-S" "08:00"
spawn-at-startup "swayidle"
spawn-at-startup "ironbar"
spawn-at-startup "mako"
spawn-at-startup "udiskie"
// only needed on void
// spawn-at-startup "pipewire"
// spawn-at-startup "wireplumber"
// spawn-at-startup "pipewire-pulse"


prefer-no-csd


animations {
    on
}


binds {
    // system & meta
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Shift+ESCAPE { quit; }

    // applications
    Mod+Return hotkey-overlay-title="Terminal" { spawn "kitty"; }
    Mod+B hotkey-overlay-title="Web Browser" { spawn "brave"; }
    Super+ESCAPE hotkey-overlay-title="Lock Screen" { spawn "swaylock"; }

    // scripts & shell commands
    Mod+R hotkey-overlay-title="Application Launcher" { spawn "~/.config/rofi/scripts/launcher.sh"; }
    Mod+P hotkey-overlay-title="Power Menu" { spawn "~/.config/rofi/scripts/powermenu.sh"; }
    Mod+T hotkey-overlay-title="Screenshot Monitor" { spawn "~/.config/scripts/screenshot.sh" "output"; }
    Mod+Shift+T hotkey-overlay-title="Screenshot Region" { spawn "~/.config/scripts/screenshot.sh" "region"; }

    // media & hardware
    XF86AudioRaiseVolume allow-when-locked=true { spawn "~/.config/scripts/volume_up.sh"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "~/.config/scripts/volume_down.sh"; }
    XF86AudioMute        allow-when-locked=true { spawn "~/.config/scripts/volume_mute.sh"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "~/.config/scripts/mic_volume_mute.sh"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "~/.config/scripts/brightness_up.sh"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "~/.config/scripts/brightness_down.sh"; }

    // navigation (focus)
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    // workspace navigation
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }

    // window & column movement
    Mod+Shift+U         { move-column-to-workspace-down; }
    Mod+Shift+I         { move-column-to-workspace-up; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+J     { move-window-down; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+L     { move-column-right; }

    // workspace indexing
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // window management
    Mod+C { close-window; }
    Mod+O { toggle-overview; }
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+W { toggle-column-tabbed-display; }
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    // sizing
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+M { maximize-window-to-edges; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
}
